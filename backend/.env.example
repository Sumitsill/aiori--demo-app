# FitPulse Backend Configuration
ENVIRONMENT=development
PORT=8001
HOST=0.0.0.0

# Database Configuration (PostgreSQL with graceful SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitpulse
# For standalone local run without PostgreSQL daemon:
# DATABASE_URL=sqlite:///./fitpulse.db

# JWT Authentication
JWT_SECRET_KEY=fitpulse_jwt_secret_dev_key_super_secure_change_in_prod_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AIORI-3 Consent Platform Integration (Two-Device Configurable)
AIORI_BASE_URL=http://127.0.0.1:8000
AIORI_CONSUMER_API_KEY=fitpulse_api_key_live_2026
AIORI_CONSUMER_ID=consumer_fitpulse
AIORI_TIMEOUT_SECONDS=5.0

